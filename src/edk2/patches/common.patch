-
-    ASSERT_EFI_ERROR (Status);
-
-    Visitor (Name, &Guid, Context);
+    if (Status == EFI_NOT_FOUND) {
+      break;
+    }
+
+    //
+    // The DXE core exposes GetNextVariableName() before a variable driver has
+    // installed the real runtime service.  In that window it returns
+    // EFI_NOT_AVAILABLE_YET.  Do not spin forever with an unchanged empty
+    // name if the variable backend failed to become available; a later boot
+    // manager path can still operate without platform-recovery variables.
+    //
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "[Bds] GetNextVariableName failed: %r\n", Status));
+      break;
+    }
+
+    Visitor (Name, &Guid, Context);
   }
 
   FreePool (Name);
diff --git a/MdeModulePkg/Universal/HiiDatabaseDxe/String.c b/MdeModulePkg/Universal/HiiDatabaseDxe/String.c
index 96202de..3d93c19 100644
--- a/MdeModulePkg/Universal/HiiDatabaseDxe/String.c
+++ b/MdeModulePkg/Universal/HiiDatabaseDxe/String.c
@@ -162,7 +162,9 @@ GetUnicodeStringTextOrSize (
 
   StringSize = sizeof (CHAR16);
   StringPtr  = StringSrc;
-  while (ReadUnaligned16 ((UINT16 *)StringPtr) != 0) {
+  // String blocks may be unaligned. A UTF-16 terminator is two zero bytes;
+  // testing bytes avoids an out-of-line unaligned-read helper for every glyph.
+  while ((StringPtr[0] != 0) || (StringPtr[1] != 0)) {
     StringSize += sizeof (CHAR16);
     StringPtr  += sizeof (CHAR16);
   }
