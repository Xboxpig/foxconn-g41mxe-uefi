+		cmocka_unit_test(efi_test_new_write),
+		cmocka_unit_test(efi_test_asus_fan_roundtrip),
+		cmocka_unit_test(efi_test_asus_memory_roundtrip)
 	};
 
 	return cb_run_group_tests(tests, NULL, NULL);
