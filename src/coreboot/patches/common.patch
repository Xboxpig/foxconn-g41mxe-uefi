+static void efi_test_asus_fan_roundtrip(void **state)
+{
+	static const EFI_GUID guid = {
+		0xec87d643, 0xeba4, 0x4bb5, {0xa1, 0xe5, 0x3f, 0x3e, 0x36, 0xb2, 0x0d, 0xa9}};
+	uint8_t data[144] = {0}, readback[144];
+	uint32_t size;
+	unsigned int profile = 99;
+
+	mock_rdev(true);
+	data[0] = 1;
+	data[8] = 1; /* CPU Silent, chassis Q-Fan disabled. */
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &guid, "AsusQFanSetupData",
+			data, sizeof(data)), CB_SUCCESS);
+	mock_rdev(false); /* Reopen the existing store without erasing it. */
+	size = sizeof(readback);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &guid, "AsusQFanSetupData",
+			readback, &size), CB_SUCCESS);
+	assert_memory_equal(data, readback, sizeof(data));
+	assert_true(asus_g41_fan_policy(readback, size, 1, &profile));
+	assert_int_equal(profile, 0);
+	assert_true(asus_g41_fan_policy(readback, size, 0, &profile));
+	assert_int_equal(profile, 3);
+
+	data[8] = 2; /* Updated value must win over the earlier variable record. */
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &guid, "AsusQFanSetupData",
+			data, sizeof(data)), CB_SUCCESS);
+	mock_rdev(false);
+	size = sizeof(readback);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &guid, "AsusQFanSetupData",
+			readback, &size), CB_SUCCESS);
+	assert_true(asus_g41_fan_policy(readback, size, 1, &profile));
+	assert_int_equal(profile, 2);
+	profile = 99;
+	assert_false(asus_g41_fan_policy(readback, size - 1, 1, &profile));
+	assert_int_equal(profile, 99);
+}
+
+static void efi_test_asus_memory_roundtrip(void **state)
+{
+	static const EFI_GUID guid = {
+		0x72c5e28c, 0x7783, 0x43a1, {0x87, 0x67, 0xfa, 0xd7, 0x3f, 0xcc, 0xaf, 0xa4}};
+	uint8_t data[1282] = {0}, readback[1282];
+	uint32_t size;
+	unsigned int mhz = 99;
+
+	mock_rdev(true);
+	data[0x18e] = 0x2b;
+	data[0x18f] = 4; /* Donor 1067 MHz -> coreboot 1066. */
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &guid, "SaSetup",
+			data, sizeof(data)), CB_SUCCESS);
+	mock_rdev(false);
+	size = sizeof(readback);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &guid, "SaSetup",
+			readback, &size), CB_SUCCESS);
+	assert_memory_equal(data, readback, sizeof(data));
+	assert_true(asus_g41_memory_policy(readback, size, &mhz));
+	assert_int_equal(mhz, 1066);
+	data[0x18e] = 0x40;
+	data[0x18f] = 6; /* A saved DDR4-only 1600 setting must not be applied. */
+	assert_int_equal(efi_fv_set_option(&flash_rdev_rw, &guid, "SaSetup",
+			data, sizeof(data)), CB_SUCCESS);
+	mock_rdev(false);
+	size = sizeof(readback);
+	assert_int_equal(efi_fv_get_option(&flash_rdev_rw, &guid, "SaSetup",
+			readback, &size), CB_SUCCESS);
+	mhz = 99;
+	assert_false(asus_g41_memory_policy(readback, size, &mhz));
+	assert_int_equal(mhz, 99);
+}
+
