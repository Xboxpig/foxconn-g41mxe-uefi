@@ -95,6 +95,16 @@ static int lookup_store(struct region_device *rstore)
 	if (boot_device_ro_subregion(&region, &read_rdev) < 0)
 		return -1;
 
+	/*
+	 * Some platforms cannot access the SPI write interface before ramstage.
+	 * The store is still readable through the memory-mapped boot device, which
+	 * is sufficient for early option retrieval.
+	 */
+	if (CONFIG(BOOT_DEVICE_SPI_FLASH_NO_EARLY_WRITES) &&
+	    !ENV_RAMSTAGE && !ENV_SMM)
+		return rdev_chain(rstore, &read_rdev, 0,
+				  region_device_sz(&read_rdev));
+
 	if (boot_device_rw_subregion(&region, &write_rdev) < 0)
 		return -1;
 
