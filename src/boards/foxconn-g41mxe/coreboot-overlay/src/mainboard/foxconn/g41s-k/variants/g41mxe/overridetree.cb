## SPDX-License-Identifier: GPL-2.0-or-later

chip northbridge/intel/x4x		# Northbridge
	device domain 0 on		# PCI domain
		subsystemid 0x105b 0x0dc2 inherit
		chip southbridge/intel/i82801gx		# Southbridge
			device pci 1f.0 on		# ISA bridge
				chip superio/ite/it8720f	# Super I/O
					register "use_fan_profile" = "true"
					# P10 EC51=03; verified TMPIN2 diode gives 30-32 C.
					register "TMPIN2.mode" = "THERMAL_DIODE"
					register "TMPIN2.offset" = "0"
					device pnp 2e.0 on	# Floppy
						io 0x60 = 0x3f0
						irq 0x70 = 6
						drq 0x74 = 2
					end
					device pnp 2e.2 on	# COM2
						io 0x60 = 0x2f8
						irq 0x70 = 3
						irq 0xf0 = 0x00
						irq 0xf1 = 0x50
					end
					device pnp 2e.3 on	# Parallel port
						io 0x60 = 0x378
						io 0x62 = 0x000
						irq 0x70 = 7
					end
					device pnp 2e.a on	# CIR
						io 0x60 = 0x3e0
						irq 0x70 = 0x0a
						irq 0xf0 = 0x00
					end
				end
			end
			device pci 1f.1 on end		# PATA/IDE
		end
	end
end
