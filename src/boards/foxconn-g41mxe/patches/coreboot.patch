+static void q35_smm_relocation_handler(int cpu, uintptr_t curr_smbase,
+				       uintptr_t staggered_smbase)
+{
+	union q35_smm_save_state *save_state =
+		(void *)(curr_smbase + SMM_DEFAULT_SIZE - sizeof(*save_state));
+	const u32 revision = save_state->legacy.smm_revision;
+
+	switch (revision) {
+	case 0x00020000:
+		save_state->legacy.smbase = staggered_smbase;
+		break;
+	case 0x00020064:
+		save_state->amd64.smbase = staggered_smbase;
+		break;
+	default:
+		printk(BIOS_ERR, "Unknown Q35 SMM revision 0x%x, not relocating CPU %d\n",
+		       revision, cpu);
+		return;
+	}
+
+	printk(BIOS_DEBUG, "Q35 shim SMM revision: 0x%08x\n", revision);
+	printk(BIOS_DEBUG, "New SMBASE=0x%08x\n", (u32)staggered_smbase);
+}
