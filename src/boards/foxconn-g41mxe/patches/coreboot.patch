+#define QEMU_CMOS_ADDR_PORT 0x70
+#define QEMU_CMOS_DATA_PORT 0x71
+#define QEMU_CMOS_LOW_RAM   0x34
+#define QEMU_CMOS_HIGH_RAM  0x35
+
+static uintptr_t q35_shim_top_of_ram(void)
+{
+	unsigned long tomk;
+
+	outb(QEMU_CMOS_HIGH_RAM, QEMU_CMOS_ADDR_PORT);
+	tomk = (unsigned long)inb(QEMU_CMOS_DATA_PORT) << 14;
+	outb(QEMU_CMOS_LOW_RAM, QEMU_CMOS_ADDR_PORT);
+	tomk |= (unsigned long)inb(QEMU_CMOS_DATA_PORT) << 6;
+	tomk += 16 * 1024;
+
+	return tomk * KiB;
+}
