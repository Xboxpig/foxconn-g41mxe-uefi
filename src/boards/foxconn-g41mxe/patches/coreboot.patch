+static void apply_fan_profile(struct ite_ec_config *ec)
+{
+	struct ite_ec_fan_config *fan;
+	const unsigned int profile = get_uint_option("fan_profile",
+						     ITE_FAN_PROFILE_BALANCED);
+
+	if (profile > ITE_FAN_PROFILE_FULL_SPEED) {
+		printk(BIOS_WARNING, "IT8720F: invalid fan profile %u, using board defaults\n",
+		       profile);
+		return;
+	}
+
+	for (size_t i = 0; i < 2; i++) {
+		const unsigned int selected = CONFIG(G41MXE_ASUS_SETTINGS) ?
+			get_uint_option(i ? "cpu_fan_profile" : "chassis_fan_profile", profile) :
+			profile;
+		fan = &ec->fan[i];
+		if (selected > ITE_FAN_PROFILE_FULL_SPEED)
+			continue;
+
+		if (selected == ITE_FAN_PROFILE_FULL_SPEED) {
+			fan->mode = FAN_MODE_ON;
+			continue;
+		}
+
+		fan->mode = FAN_SMART_AUTOMATIC;
+		fan->smart.smoothing = 1;
+
+		switch (selected) {
+		case ITE_FAN_PROFILE_SILENT:
+			fan->smart.tmp_off = 30;
+			fan->smart.tmp_start = 35;
+			fan->smart.tmp_full = 75;
+			fan->smart.pwm_start = 15;
+			fan->smart.slope = 6;
+			break;
+		case ITE_FAN_PROFILE_PERFORMANCE:
+			fan->smart.tmp_off = 20;
+			fan->smart.tmp_start = 25;
+			fan->smart.tmp_full = 55;
+			fan->smart.pwm_start = 35;
+			fan->smart.slope = 12;
+			break;
+		case ITE_FAN_PROFILE_BALANCED:
+		default:
+			/* Keep the board's devicetree curve. */
+			break;
+		}
+	}
+}
