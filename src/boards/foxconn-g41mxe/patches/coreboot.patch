index d634c963..39d4c327 100644
--- a/src/drivers/efi/option.c
+++ b/src/drivers/efi/option.c
@@ -6,6 +6,45 @@
 #include <Uefi/UefiBaseType.h>
 
 #include "efivars.h"
+#if CONFIG(G41MXE_ASUS_SETTINGS)
+#include <console/console.h>
+#include <string.h>
+#include "asus_g41_policy.h"
+
+static bool asus_g41_option(const struct region_device *rdev, const char *name,
+			    unsigned int *value)
+{
+	static const EFI_GUID setup_guid = {
+		0xec87d643, 0xeba4, 0x4bb5, {0xa1, 0xe5, 0x3f, 0x3e, 0x36, 0xb2, 0x0d, 0xa9}};
+	static const EFI_GUID sa_guid = {
+		0x72c5e28c, 0x7783, 0x43a1, {0x87, 0x67, 0xfa, 0xd7, 0x3f, 0xcc, 0xaf, 0xa4}};
+	unsigned char data[1282];
+	uint32_t size;
+	bool valid;
+	enum cb_err ret;
+
+	if (!strcmp(name, "cpu_fan_profile") || !strcmp(name, "chassis_fan_profile")) {
+		size = 144;
+		ret = efi_fv_get_option(rdev, &setup_guid, "AsusQFanSetupData", data, &size);
+		if (ret != CB_SUCCESS)
+			return false;
+		valid = asus_g41_fan_policy(data, size, !strcmp(name, "cpu_fan_profile"), value);
+	} else if (!strcmp(name, "max_mem_speed")) {
+		size = sizeof(data);
+		ret = efi_fv_get_option(rdev, &sa_guid, "SaSetup", data, &size);
+		if (ret != CB_SUCCESS)
+			return false;
+		valid = asus_g41_memory_policy(data, size, value);
+	} else {
+		return false;
+	}
+	if (valid)
+		printk(BIOS_INFO, "ASUS G41 bridge: %s=%u\n", name, *value);
+	else
+		printk(BIOS_WARNING, "ASUS G41 bridge: unsupported %s; keeping native policy\n", name);
+	return valid;
+}
+#endif
 
