 	0xceae4c1d, 0x335b, 0x4685, { 0xa4, 0xa0, 0xfc, 0x4a, 0x94, 0xee, 0xa0, 0x85 } };
@@ -20,6 +59,11 @@ unsigned int get_uint_option(const char *name, const unsigned int fallback)
 	if (smmstore_lookup_region(&rdev))
 		return fallback;
 
+#if CONFIG(G41MXE_ASUS_SETTINGS)
+	if (asus_g41_option(&rdev, name, &var))
+		return var;
+#endif
+
 	var = 0;
 	size = sizeof(var);
 	ret = efi_fv_get_option(&rdev, &EficorebootNvDataGuid, name, &var, &size);
