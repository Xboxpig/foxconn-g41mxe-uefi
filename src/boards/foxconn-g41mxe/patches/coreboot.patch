+union __packed q35_smm_save_state {
+	amd64_smm_state_save_area_t amd64;
+	struct {
+		char reserved[sizeof(amd64_smm_state_save_area_t) -
+			      sizeof(legacy_smm_state_save_area_t)];
+		legacy_smm_state_save_area_t legacy;
+	};
+};
+
+static_assert(offsetof(union q35_smm_save_state, amd64.smm_revision) ==
+	      offsetof(union q35_smm_save_state, legacy.smm_revision),
+	      "QEMU SMM revision fields must have the same offset");
+
+static void q35_get_smm_info(uintptr_t *perm_smbase, size_t *perm_smsize,
+			     size_t *smm_save_state_size)
