+# status.  Use the matching unmodified PRIME Z490-A provider so the QEMU-only
+# experiment follows the vendor rendering path and retains the original assets.
+FILE DRIVER = 5C0FB3B9-F7BB-467B-A4DC-89D7D5A58432 {
+  SECTION DXE_DEPEX_EXP = {TRUE}
+  SECTION PE32 = UefiPayloadPkg/AsusAmitseBinary/AsusResLoader.efi
+  SECTION UI = "ASUS Resource Loader (lab)"
+}
+# Original resource archive requested by AMITSE through AsusResLoader.
+FILE FREEFORM = CC5840D2-D8EA-459E-BAF4-349AC710EBBE {
+  SECTION RAW = UefiPayloadPkg/AsusAmitseBinary/AsusSetupResources.bin
+}
+# AMITSE uses the ASUS SPD-transfer protocol
+# (2B1A35EE-E799-40B4-A7BB-B3EA3535D1C7) while building the memory portion of
+# the setup UI.  The matching vendor module installs this interface from its
+# entry point.  Preserve the original implementation for the QEMU-only capture.
+FILE DRIVER = 7A54B36F-F745-462C-B11F-16E03E52B617 {
+  SECTION DXE_DEPEX_EXP = {TRUE}
+  SECTION PE32 = UefiPayloadPkg/AsusAmitseBinary/AsusSpdTransfer.efi
+  SECTION UI = "ASUS SPD Transfer (lab)"
+}
+# AMITSE's graphical setup path requires the matching vendor MouseDriver
+# protocol (C7A7030C-C3D8-45EE-BED9-5D9E76762953), even when no physical
+# pointing device is present.  Keep the original binary in this QEMU-only lab
+# path so the setup page uses ASUS's renderer instead of a reimplementation.
+FILE DRIVER = C7A7030C-C3D8-45EE-BED9-5D9E76762953 {
+  SECTION DXE_DEPEX_EXP = {TRUE}
+  SECTION PE32 = UefiPayloadPkg/AsusAmitseBinary/MouseDriver.efi
