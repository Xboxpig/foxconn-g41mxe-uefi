+!if $(ASUS_AMITSE_LAB) == TRUE
+# Research-only import of the ASUS/AMI setup browser.  Keep it isolated behind
+# an explicit build define: these proprietary binaries are not part of normal
+# UefiPayloadPkg images and are never used by the G41MXE production build.
+!if $(ASUS_SETUP_PAGE_LAB) == TRUE
+INF UefiPayloadPkg/AsusAmiCompatDxe/AsusAmiCompatDxe.inf
+!if $(ASUS_SETUP_HII_DATA_ONLY) == TRUE
+# Parse only the donor's HII resource.  The donor PE image is deliberately a
+# non-dispatchable RAW section in a FREEFORM FFS file, and the safe driver
+# registers it with DriverHandle=NULL so no vendor callback can run.
+INF UefiPayloadPkg/AsusSetupHiiDxe/AsusSetupHiiDxe.inf
+FILE FREEFORM = 6F7C8B8F-0F64-4BAA-95EE-06F749D73E9B {
+  SECTION RAW = $(ASUS_SETUP_BINARY)
+  SECTION UI = "ASUS Setup HII data only"
+}
