+# G41 HWM is supplied by AsusAmiCompatDxe; do not dispatch Z490 sensor I/O.
+# Setup requires the AMI/ASUS DXE CMOS access protocol
+# (9851740C-22E0-440D-9090-EF2D71C251C9).  Import the matching vendor
+# CmosDxe provider instead of emulating its interface in the page-capture lab.
+FILE DRIVER = 3237418A-478C-4700-B59F-768E2CCBC726 {
+  SECTION DXE_DEPEX_EXP = {TRUE}
+  SECTION PE32 = UefiPayloadPkg/AsusAmitseBinary/CmosDxe.efi
+  SECTION UI = "ASUS CmosDxe (lab)"
+}
+!endif
+# AMITSE calls the ASUS resource-loader protocol
